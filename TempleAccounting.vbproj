<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>TempleAccounting.Program</StartupObject>
    <RootNamespace>TempleAccounting</RootNamespace>
    <AssemblyName>lamYangI&amp;E</AssemblyName>
    <ApplicationIcon>lamYangI&amp;E.ico</ApplicationIcon>
    <Copyright>© 2026 พระบุญส่ง โสภณจิตฺโต. All Rights Reserved.</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <NoWarn>WFO1000</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ===== Helpers / Startup ===== -->
    <Compile Include="ErrorLogHelper.vb" />
    <Compile Include="Database.vb" />
    <Compile Include="DatabaseBackupHelper.vb" />
    <Compile Include="BackupEngine.vb" />
    <Compile Include="BackupConfig.vb" />
    <Compile Include="BackupRegistry.vb" />
    <Compile Include="DesktopShortcutHelper.vb" />
    <Compile Include="AppPaths.vb" />
    <Compile Include="AppPreferences.vb" />
    <Compile Include="AppPreferenceHelper.vb" />
    <Compile Include="OnboardingRepository.vb" />
    <Compile Include="WizardText.vb" />
    <Compile Include="HelpSystem.vb" />
    <Compile Include="SaddhiviharikaDb.vb" />
    <Compile Include="UiFitter.vb" />
    <Compile Include="Program.vb" />
    <Compile Include="ReceiptImageHelper.vb" />
    <Compile Include="MessageBoxHelper.vb" />
    <Compile Include="ExcelTransactionImporter.vb" />
    <Compile Include="TransactionExcelExporter.vb" />
    <Compile Include="Reports\IncomeExpenseReport.vb" />
    <Compile Include="Reports\ReportEngine.vb" />

    <!-- ===== frmMain ===== -->
    <Compile Include="Forms\FrmHelpDialog.vb" />
    <Compile Include="Forms\FrmHelpDialog.Designer.vb">
      <DependentUpon>FrmHelpDialog.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="frmMain.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="frmMain.Designer.vb">
      <DependentUpon>frmMain.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="frmMain.UiHelpers.vb">
      <DependentUpon>frmMain.vb</DependentUpon>
    </Compile>
    <Compile Include="Forms\FrmBackupVerify.vb">
      <SubType>Form</SubType>
    </Compile>
    <EmbeddedResource Include="Forms\FrmChartPreview.resx" />
    <EmbeddedResource Include="Forms\FrmMasterData.resx" />
    <EmbeddedResource Include="frmMain.resx">
      <DependentUpon>frmMain.vb</DependentUpon>
    </EmbeddedResource>

    <!-- ===== Receipt Viewer ===== -->
    <Compile Include="Forms\FrmReceiptViewer.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\FrmReceiptViewer.Designer.vb">
      <DependentUpon>FrmReceiptViewer.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <EmbeddedResource Include="Forms\FrmReceiptViewer.resx">
      <DependentUpon>FrmReceiptViewer.vb</DependentUpon>
    </EmbeddedResource>

    <!-- ===== Transaction Forms ===== -->
    <Compile Include="Forms\FrmIncome.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\FrmIncome.Designer.vb">
      <DependentUpon>FrmIncome.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <EmbeddedResource Include="Forms\FrmIncome.resx">
      <DependentUpon>FrmIncome.vb</DependentUpon>
    </EmbeddedResource>
    <Compile Include="Forms\FrmExpense.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\FrmExpense.Designer.vb">
      <DependentUpon>FrmExpense.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <EmbeddedResource Include="Forms\FrmExpense.resx">
      <DependentUpon>FrmExpense.vb</DependentUpon>
    </EmbeddedResource>
    <Compile Include="Forms\FrmTransfer.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\FrmTransfer.Designer.vb">
      <DependentUpon>FrmTransfer.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <EmbeddedResource Include="Forms\FrmTransfer.resx">
      <DependentUpon>FrmTransfer.vb</DependentUpon>
    </EmbeddedResource>
    <Compile Include="Forms\FrmTransactions.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\FrmTransactions.Designer.vb">
      <DependentUpon>FrmTransactions.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <EmbeddedResource Include="Forms\FrmTransactions.resx">
      <DependentUpon>FrmTransactions.vb</DependentUpon>
    </EmbeddedResource>

    <!-- ===== Master / Setting / Location / Reports ===== -->
    <Compile Include="Forms\FrmMasterData.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\FrmMasterData.Designer.vb">
      <DependentUpon>FrmMasterData.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\FrmTempleSetting.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\FrmTempleSetting.Designer.vb">
      <DependentUpon>FrmTempleSetting.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\FrmPersonnelManagement.vb" />
    <!-- ===== Onboarding Wizard ===== -->
    <Compile Include="Forms\FrmOnboardingWizard.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\FrmOnboardingWizard.Designer.vb">
      <DependentUpon>FrmOnboardingWizard.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\FrmPersonnelManagement.Designer.vb">
      <DependentUpon>FrmPersonnelManagement.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <EmbeddedResource Include="Forms\FrmPersonnelManagement.resx">
      <DependentUpon>FrmPersonnelManagement.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Forms\FrmTempleSetting.resx">
      <DependentUpon>FrmTempleSetting.vb</DependentUpon>
    </EmbeddedResource>
    <Compile Include="Forms\FrmLocationImport.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\FrmLocationImport.Designer.vb">
      <DependentUpon>FrmLocationImport.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <EmbeddedResource Include="Forms\FrmLocationImport.resx">
      <DependentUpon>FrmLocationImport.vb</DependentUpon>
    </EmbeddedResource>
    <Compile Include="Forms\FrmMultiMachineImport.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\FrmMultiMachineImport.Designer.vb">
      <DependentUpon>FrmMultiMachineImport.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <EmbeddedResource Include="Forms\FrmMultiMachineImport.resx">
      <DependentUpon>FrmMultiMachineImport.vb</DependentUpon>
    </EmbeddedResource>
    <Compile Include="Forms\FrmExportForTransfer.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\FrmExportForTransfer.Designer.vb">
      <DependentUpon>FrmExportForTransfer.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <EmbeddedResource Include="Forms\FrmExportForTransfer.resx">
      <DependentUpon>FrmExportForTransfer.vb</DependentUpon>
    </EmbeddedResource>
    <Compile Include="Forms\FrmChartPreview.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="TransferFormat.vb" />
    <Compile Include="Services\ITransactionRepository.vb" />
    <Compile Include="Services\AccessTransactionRepository.vb" />
    <Compile Include="Services\TransactionService.vb" />
    <Compile Include="Services\IDbProvider.vb" />
    <Compile Include="Services\AccessDbProvider.vb" />
    <Compile Include="Services\SqlServerDbProvider.vb" />
    <Compile Include="Services\DbProviderFactory.vb" />
    <Compile Include="Forms\FrmReports.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\FrmReports.Designer.vb">
      <DependentUpon>FrmReports.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <EmbeddedResource Include="Forms\FrmReports.resx">
      <DependentUpon>FrmReports.vb</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyTrademarkAttribute">
      <_Parameter1>พระบุญส่ง โสภณจิตฺโต</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.10" />
    <PackageReference Include="WinForms.DataVisualization" Version="1.10.2" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Database\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Import\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- คู่มือการใช้งานภาษาไทย: ต้องถูกคัดลอกไปยังโฟลเดอร์ output เพื่อให้ FrmHelpDialog อ่านได้ -->
    <None Include="USER_MANUAL_TH.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- โลโก้/แบนเนอร์หน้าหลัก: ต้องถูกคัดลอกไปยังโฟลเดอร์ output เพื่อให้ frmMain แสดงผล -->
    <None Include="Lamyang I&amp;Emain.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- ไอคอนโปรแกรม: ต้องถูกคัดลอกไปยังโฟลเดอร์ output เพื่อให้ frmMain ใช้เป็นไอคอน Taskbar -->
    <None Include="lamYangI&amp;E.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
